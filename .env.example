# =============================================================================
# STRIDE MARKETPLACE - ENVIRONMENT CONFIGURATION TEMPLATE
# =============================================================================
# Salin berkas ini menjadi .env.local untuk pengujian lokal:
#   Windows PowerShell : Copy-Item .env.example .env.local
#   Linux / macOS      : cp .env.example .env.local
# =============================================================================

# -----------------------------------------------------------------------------
# 1. DATABASE CONNECTION (POSTGRESQL) - WAJIB
# -----------------------------------------------------------------------------
# Format: postgresql://[USER]:[PASSWORD]@[HOST]:[PORT]/[DATABASE_NAME]
#
# Panduan Nilai Default:
# - USER          : postgres (default user PostgreSQL)
# - PASSWORD      : ganti dengan password postgres di komputer Anda
# - HOST          : localhost (atau 127.0.0.1)
# - PORT          : 5432 (port standar PostgreSQL)
# - DATABASE_NAME : STRIDE (otomatis dibuat oleh skrip seeder jika belum ada)
DATABASE_URL=postgresql://postgres:password_anda@localhost:5432/STRIDE

# Contoh konfigurasi Cloud PostgreSQL (Supabase / Neon / Railway / Aiven):
# DATABASE_URL=postgresql://postgres.projectref:password@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?sslmode=require

# -----------------------------------------------------------------------------
# 2. NEXT.JS SERVER & URL (OPSIONAL)
# -----------------------------------------------------------------------------
PORT=3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
